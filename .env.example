# ---------------------------------------------------------------------------
# TP8 — Variables de la stack. Copie ce fichier en « .env » et adapte-le.
#     cp .env.example .env
# ---------------------------------------------------------------------------

# Ton identifiant de candidat : il devient le label « candidate » de toutes
# tes métriques et le nom affiché dans Grafana.
CAND=cand-XX

# --- Ports publiés sur la VM ------------------------------------------------
# Change-les si la VM fait déjà tourner quelque chose sur ces ports.
# Sur la VM Apache des TP1/TP2, 80, 9100, 9117 et 12345 sont déjà pris :
# les valeurs ci-dessous les évitent toutes.
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
PUSHGATEWAY_PORT=9091
GRAFANA_PORT=3000
MAILPIT_PORT=8025
APACHE_PORT=8080

# --- Profil « traces » ------------------------------------------------------
TEMPO_PORT=3200
APP_PORT=8081
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# --- Grafana ----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=tp8-observabilite

# --- PostgreSQL (profil traces) ---------------------------------------------
POSTGRES_USER=boutique
POSTGRES_PASSWORD=boutique
POSTGRES_DB=boutique
